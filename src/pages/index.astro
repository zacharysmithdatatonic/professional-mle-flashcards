---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CertificationSelector } from '../components/react/CertificationSelector';
import { RELEASE_TAG, RELEASE_URL } from '../lib/version';
---

<BaseLayout>
    <CertificationSelector client:load />
    <a
        class="app-version"
        href={RELEASE_URL}
        target="_blank"
        rel="noopener noreferrer"
        title={`Release ${RELEASE_TAG}`}
    >
        {RELEASE_TAG}
    </a>
</BaseLayout>

<style>
    .app-version {
        position: fixed;
        right: 0.75rem;
        bottom: 0.5rem;
        font-size: 0.6875rem;
        letter-spacing: 0.02em;
        color: #9aa0a6;
        font-variant-numeric: tabular-nums;
    }

    .app-version:hover {
        color: #5f6368;
        text-decoration: none;
    }
</style>
