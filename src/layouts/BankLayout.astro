---
import { ArrowLeft, Home } from 'lucide-react';
import BaseLayout from './BaseLayout.astro';
import type { QuestionBank, StudyMode } from '../lib/banks';
import { getBankBasePath, MODE_LABELS, MODE_SHORT_LABELS } from '../lib/banks';
import {
    getCertificationIconComponent,
    getStudyModeIconComponent,
} from '../lib/certificationIcons';

interface Props {
    bank: QuestionBank;
    mode?: StudyMode | null;
    title?: string;
    wide?: boolean;
}

const { bank, mode = null, title, wide = false } = Astro.props;
const pageTitle =
    title ??
    (mode ? `${MODE_LABELS[mode]} — ${bank.name}` : `${bank.name} Flashcards`);
const bankHref = getBankBasePath(bank);
const CertificationIcon = getCertificationIconComponent(bank.key);
const ModeIcon = mode ? getStudyModeIconComponent(mode) : null;
const backHref = mode ? bankHref : import.meta.env.BASE_URL;
const backLabel = mode ? 'Back to menu' : 'Back to certifications';
const hideDefaultBack = mode === 'exam';
const showModeSettings = mode === 'quiz' || mode === 'review';
---

<BaseLayout title={pageTitle}>
    <div class="bank-layout">
        <header class="bank-header">
            {
                hideDefaultBack ? (
                    <div class="bank-back" data-exam-exit />
                ) : (
                    <a
                        class="bank-back"
                        href={backHref}
                        aria-label={backLabel}
                        title={backLabel}
                    >
                        <ArrowLeft size={18} strokeWidth={1.5} />
                    </a>
                )
            }
            <nav class="bank-breadcrumbs" aria-label="Breadcrumb">
                <a class="crumb" href={import.meta.env.BASE_URL}>
                    <Home size={16} strokeWidth={1.5} />
                    <span>Certifications</span>
                </a>
                <span class="crumb-separator" aria-hidden="true">/</span>
                {
                    mode ? (
                        <a class="crumb" href={bankHref}>
                            <CertificationIcon size={16} strokeWidth={1.5} />
                            <span>{bank.name}</span>
                            {bank.beta ? (
                                <span class="beta-badge">Beta</span>
                            ) : null}
                        </a>
                    ) : (
                        <span class="crumb" aria-current="page">
                            <CertificationIcon size={16} strokeWidth={1.5} />
                            <span>{bank.name}</span>
                            {bank.beta ? (
                                <span class="beta-badge">Beta</span>
                            ) : null}
                        </span>
                    )
                }
                {
                    mode && ModeIcon ? (
                        <>
                            <span class="crumb-separator" aria-hidden="true">
                                /
                            </span>
                            <span class="crumb" aria-current="page">
                                <ModeIcon size={16} strokeWidth={1.5} />
                                <span>{MODE_SHORT_LABELS[mode]}</span>
                            </span>
                        </>
                    ) : null
                }
            </nav>
            {
                showModeSettings ? (
                    <div class="bank-settings" data-mode-settings />
                ) : null
            }
        </header>
        <main class:list={['bank-main', { wide }]}>
            <slot />
        </main>
    </div>
</BaseLayout>

<style>
    .bank-layout {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .bank-header {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 0;
    }

    .bank-breadcrumbs {
        grid-column: 2;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        line-height: 1;
        color: #5f6368;
    }

    .crumb {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .crumb svg {
        display: block;
        flex-shrink: 0;
    }

    .beta-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        background: #e8f0fe;
        color: #1a73e8;
        border: 1px solid #cce0ff;
        line-height: 1.2;
    }

    .crumb-separator {
        color: #dadce0;
    }

    .bank-back {
        grid-column: 1;
        justify-self: start;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 999px;
        color: #5f6368;
    }

    .bank-back svg {
        display: block;
    }

    .bank-back:hover {
        background: #f1f3f4;
        text-decoration: none;
    }

    [data-exam-exit] {
        cursor: pointer;
    }

    .bank-settings {
        grid-column: 3;
        justify-self: end;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        color: #5f6368;
    }

    .bank-main {
        flex: 1;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .bank-main.wide {
        max-width: none;
        padding: 0;
    }

    @media (max-width: 600px) {
        .bank-header {
            grid-template-columns: auto 1fr auto;
        }

        .bank-breadcrumbs {
            justify-content: flex-start;
        }

        .bank-breadcrumbs > :not([aria-current='page']) {
            display: none;
        }
    }
</style>
